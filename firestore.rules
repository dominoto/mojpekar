rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function userPath() { return /databases/$(database)/documents/users/$(myEmail()); }

    // Glavni administrator — isti e-mail kao ADMIN_EMAIL u js/firebase-config.js
    function isSuperAdmin() { return signedIn() && myEmail() == 'tvoj.email@gmail.com'; }
    function isMember() { return signedIn() && exists(userPath()); }
    function isAdmin() { return isSuperAdmin() || (isMember() && get(userPath()).data.isAdmin == true); }
    function canEditPastries() {
      return isAdmin() || (isMember() && get(userPath()).data.canEditPastries == true);
    }

    match /users/{email} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /pastries/{id} {
      allow read: if true;
      allow create, update: if canEditPastries()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 500;
      allow delete: if isAdmin();
    }

    match /rankings/{email} {
      allow read: if true;
      allow write: if (isMember() || isSuperAdmin())
        && email == myEmail()
        && request.resource.data.order is list
        && request.resource.data.order.size() <= 500;
      allow delete: if isAdmin();
    }
  }
}
